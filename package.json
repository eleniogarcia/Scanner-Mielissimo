{
  "name": "mielissimo-pos",
  "version": "1.0.0",
  "description": "Sistema POS para Mielissimo - Aplicación de Escritorio",
  "main": "electron-main.js",
  "scripts": {
    "start": "electron .",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\" \"wait-on http://localhost:5173 && npm run dev:electron\"",
    "dev:backend": "cd backend && cross-env NODE_ENV=development node server.js",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:electron": "wait-on http://localhost:5173 && electron .",
    "build:frontend": "cd frontend && npm run build",
    "rebuild:backend": "cd backend && npx electron-rebuild -f -w better-sqlite3 -v 40.6.0",
    "build": "npm run build:frontend && npm run rebuild:backend && electron-builder",
    "build:win": "npm run build:frontend && npm run rebuild:backend && electron-builder --win",
    "postinstall": "cd backend && npm install && cd ../frontend && npm install"
  },
  "build": {
    "appId": "com.mielissimo.pos",
    "productName": "Mielissimo",
    "artifactName": "Mielissimo Setup ${version}.${ext}",
    "asar": false,
    "buildDependenciesFromSource": true,
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "electron-main.js",
      "backend/**/*",
      "!backend/node_modules/@types/**/*",
      "!backend/**/*.log",
      "frontend/dist/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "executableName": "Mielissimo",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Mielissimo"
    }
  },
  "keywords": [
    "pos",
    "punto de venta",
    "mielissimo",
    "ventas",
    "electron"
  ],
  "author": "Mielissimo",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^40.6.0",
    "electron-builder": "^26.8.1",
    "wait-on": "^9.0.4"
  },
  "dependencies": {
    "html2canvas": "^1.4.1"
  }
}
