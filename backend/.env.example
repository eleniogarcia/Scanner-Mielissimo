# Base de datos PostgreSQL (Local)
DATABASE_URL=postgresql://usuario:password@localhost:5432/pos_db

# Base de datos PostgreSQL (Supabase - Production)
# Formato: postgresql://postgres:[YOUR-PASSWORD]@[PROJECT-REF].supabase.co:5432/postgres
# Ejemplo: DATABASE_URL=postgresql://postgres:tu_password@db.abcdefghijk.supabase.co:5432/postgres

# Puerto del servidor
PORT=3000

# Entorno (development, production)
NODE_ENV=development
